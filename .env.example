# Copy to .env.local (not committed) or set in your host's build settings.
# Empty = call the backend through the same origin (/api): Vite dev proxy locally, nginx BACKEND_URL proxy in Docker.
# Set it to call the backend directly, e.g. on Railway/Netlify/Vercel static hosting:
# VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=
